// TASK-000 initialization only. Add models and migrations in their assigned tasks.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum EducationProgramStatus {
  ACTIVE
  INACTIVE
}

enum EducationBatchStatus {
  ACTIVE
  INACTIVE
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

enum CurriculumStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id                String               @id @default(uuid()) @db.Uuid
  code              String               @unique
  name              String
  parentId          String?              @map("parent_id") @db.Uuid
  parent            Organization?        @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children          Organization[]       @relation("OrganizationHierarchy")
  organizationType  String?              @map("organization_type")
  status            OrganizationStatus   @default(ACTIVE)
  metadata          Json?
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  placements        PersonOrganization[]
  educationPrograms EducationProgram[]

  @@index([parentId])
  @@index([status])
  @@index([organizationType])
  @@map("organizations")
}

model EducationProgram {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code             String
  name             String
  description      String?
  status           EducationProgramStatus @default(ACTIVE)
  metadata         Json?
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  curriculums      Curriculum[]
  educationBatches EducationBatch[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@map("education_programs")
}

model Subject {
  id                       String                    @id @default(uuid()) @db.Uuid
  code                     String                    @unique
  name                     String
  description              String?
  status                   SubjectStatus             @default(ACTIVE)
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  curriculumSubjects       CurriculumSubject[]
  graduationRuleComponents GraduationRuleComponent[]

  @@index([status])
  @@map("subjects")
}

model Curriculum {
  id                 String              @id @default(uuid()) @db.Uuid
  educationProgramId String              @map("education_program_id") @db.Uuid
  educationProgram   EducationProgram    @relation(fields: [educationProgramId], references: [id], onDelete: Restrict)
  version            String
  name               String
  effectiveFrom      DateTime?           @map("effective_from") @db.Date
  status             CurriculumStatus    @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  curriculumSubjects CurriculumSubject[]
  educationBatches   EducationBatch[]

  @@unique([educationProgramId, version])
  @@index([educationProgramId])
  @@index([status])
  @@map("curriculums")
}

model CurriculumSubject {
  id            String         @id @default(uuid()) @db.Uuid
  curriculumId  String         @map("curriculum_id") @db.Uuid
  curriculum    Curriculum     @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  subjectId     String         @map("subject_id") @db.Uuid
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  sequence      Int            @default(1)
  creditHours   Int?           @map("credit_hours")
  required      Boolean        @default(false)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  classSubjects ClassSubject[]
  questionBanks QuestionBank[]

  @@unique([curriculumId, subjectId])
  @@index([curriculumId])
  @@index([subjectId])
  @@map("curriculum_subjects")
}

model ClassSubject {
  id                  String               @id @default(uuid()) @db.Uuid
  academicClassId     String               @map("academic_class_id") @db.Uuid
  academicClass       AcademicClass        @relation(fields: [academicClassId], references: [id], onDelete: Restrict)
  curriculumSubjectId String               @map("curriculum_subject_id") @db.Uuid
  curriculumSubject   CurriculumSubject    @relation(fields: [curriculumSubjectId], references: [id], onDelete: Restrict)
  code                String?
  displayName         String?              @map("display_name")
  startDate           DateTime?            @map("start_date") @db.Date
  endDate             DateTime?            @map("end_date") @db.Date
  status              ClassSubjectStatus   @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  educatorAssignments EducatorAssignment[]
  schedules           AcademicSchedule[]
  meetings            LearningMeeting[]
  attendanceSessions  AttendanceSession[]
  assessments         Assessment[]
  gradingSchemes      GradingScheme[]
  finalGrades         FinalGrade[]

  @@unique([academicClassId, curriculumSubjectId])
  @@index([academicClassId])
  @@index([curriculumSubjectId])
  @@index([status])
  @@map("class_subjects")
}

enum ClassSubjectStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

/// A person's participation in a batch. This is the enduring education record:
/// withdrawal and completion change `status`, they never delete the row, so the
/// education history of a person stays reconstructible.
model Enrollment {
  id               String           @id @default(uuid()) @db.Uuid
  personId         String           @map("person_id") @db.Uuid
  person           Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  educationBatchId String           @map("education_batch_id") @db.Uuid
  educationBatch   EducationBatch   @relation(fields: [educationBatchId], references: [id], onDelete: Restrict)
  academicClassId  String?          @map("academic_class_id") @db.Uuid
  academicClass    AcademicClass?   @relation(fields: [academicClassId], references: [id], onDelete: Restrict)
  enrollmentNumber String?          @unique @map("enrollment_number")
  enrolledAt       DateTime         @map("enrolled_at") @db.Date
  status           EnrollmentStatus @default(ACTIVE)
  completedAt      DateTime?        @map("completed_at") @db.Date
  metadata         Json?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  progress              LearningProgress[]
  submissions           AssignmentSubmission[]
  attendanceRecords     AttendanceRecord[]
  examParticipants      ExamParticipant[]
  finalGrades           FinalGrade[]
  graduationEvaluations GraduationEvaluation[]

  @@unique([personId, educationBatchId])
  @@index([personId])
  @@index([educationBatchId])
  @@index([academicClassId])
  @@index([status])
  @@map("enrollments")
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
}

enum MasterStatus {
  ACTIVE
  INACTIVE
}

/// Educator type is data, not an enum: Gadik, instruktur, penguji, pembimbing and
/// any future role are seeded rows so the institution can extend its own
/// vocabulary without a code change.
model EducatorType {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique
  name        String
  description String?
  status      MasterStatus         @default(ACTIVE)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  assignments EducatorAssignment[]

  @@index([status])
  @@map("educator_types")
}

/// Teaching assignment: one person teaches one class subject for a period.
/// A person may hold assignments across institutions and programs; nothing here
/// ties a person to a single organization.
model EducatorAssignment {
  id             String           @id @default(uuid()) @db.Uuid
  personId       String           @map("person_id") @db.Uuid
  person         Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  classSubjectId String           @map("class_subject_id") @db.Uuid
  classSubject   ClassSubject     @relation(fields: [classSubjectId], references: [id], onDelete: Restrict)
  educatorTypeId String           @map("educator_type_id") @db.Uuid
  educatorType   EducatorType     @relation(fields: [educatorTypeId], references: [id], onDelete: Restrict)
  validFrom      DateTime         @map("valid_from") @db.Date
  validUntil     DateTime?        @map("valid_until") @db.Date
  status         AssignmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([personId])
  @@index([classSubjectId])
  @@index([educatorTypeId])
  @@index([status])
  @@index([validFrom, validUntil])
  @@map("educator_assignments")
}

/// Class staff (wali kelas, admin kelas, ...) is a separate assignment from
/// teaching: a homeroom teacher is not thereby a subject educator.
model ClassStaffAssignment {
  id              String           @id @default(uuid()) @db.Uuid
  personId        String           @map("person_id") @db.Uuid
  person          Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  academicClassId String           @map("academic_class_id") @db.Uuid
  academicClass   AcademicClass    @relation(fields: [academicClassId], references: [id], onDelete: Restrict)
  staffType       String           @map("staff_type")
  validFrom       DateTime         @map("valid_from") @db.Date
  validUntil      DateTime?        @map("valid_until") @db.Date
  status          AssignmentStatus @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([personId])
  @@index([academicClassId])
  @@index([staffType])
  @@index([status])
  @@index([validFrom, validUntil])
  @@map("class_staff_assignments")
}

enum AssignmentStatus {
  ACTIVE
  ENDED
  CANCELLED
}

/// A scheduled academic activity for one class subject. Scheduling is kept
/// separate from learning content: a timetable entry exists whether or not any
/// material has been authored yet, and content can be reused across schedules.
model AcademicSchedule {
  id             String                 @id @default(uuid()) @db.Uuid
  classSubjectId String                 @map("class_subject_id") @db.Uuid
  classSubject   ClassSubject           @relation(fields: [classSubjectId], references: [id], onDelete: Restrict)
  title          String
  description    String?
  startAt        DateTime               @map("start_at")
  endAt          DateTime               @map("end_at")
  mode           AcademicScheduleMode   @default(FACE_TO_FACE)
  location       String?
  url            String?
  status         AcademicScheduleStatus @default(SCHEDULED)
  metadata       Json?
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@index([classSubjectId])
  @@index([startAt, endAt])
  @@index([status])
  @@map("academic_schedules")
}

enum AcademicScheduleMode {
  FACE_TO_FACE
  ONLINE
  BLENDED
}

enum AcademicScheduleStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

/// A learning meeting is the container for learning activities. The sequence is
/// the pedagogical order of the meeting inside its class subject (Pertemuan 1,
/// 2, ...) and is unique per class subject, so content and progress can address
/// a meeting deterministically instead of by date.
model LearningMeeting {
  id             String                @id @default(uuid()) @db.Uuid
  classSubjectId String                @map("class_subject_id") @db.Uuid
  classSubject   ClassSubject          @relation(fields: [classSubjectId], references: [id], onDelete: Restrict)
  sequence       Int
  title          String
  description    String?
  plannedStartAt DateTime?             @map("planned_start_at")
  plannedEndAt   DateTime?             @map("planned_end_at")
  status         LearningMeetingStatus @default(DRAFT)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  activities         LearningActivity[]
  attendanceSessions AttendanceSession[]

  @@unique([classSubjectId, sequence])
  @@index([classSubjectId])
  @@index([status])
  @@map("learning_meetings")
}

/// Per-participant, per-activity progress.
///
/// One row per (enrollment, activity). `progressPercent` is the authority for
/// how far the participant got; `status` is the coarse lifecycle and must agree
/// with it (100 <=> COMPLETED). Completion is idempotent: re-sending a completed
/// update changes nothing and produces no duplicate audit entry, because the
/// caller's retry must not look like a second business event.
model LearningProgress {
  id              String                 @id @default(uuid()) @db.Uuid
  enrollmentId    String                 @map("enrollment_id") @db.Uuid
  enrollment      Enrollment             @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  activityId      String                 @map("activity_id") @db.Uuid
  activity        LearningActivity       @relation(fields: [activityId], references: [id], onDelete: Restrict)
  status          LearningProgressStatus @default(NOT_STARTED)
  progressPercent Int                    @default(0) @map("progress_percent")
  startedAt       DateTime?              @map("started_at")
  completedAt     DateTime?              @map("completed_at")
  lastAccessedAt  DateTime?              @map("last_accessed_at")
  metadata        Json?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@unique([enrollmentId, activityId])
  @@index([enrollmentId, status])
  @@index([activityId])
  @@index([status])
  @@map("learning_progress")
}

enum LearningProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/// Read model for dashboard and reporting reads.
///
/// "Aggregate disimpan/dioptimalkan; jangan hitung seluruh histori setiap
/// dashboard request" is satisfied literally: this table is maintained
/// incrementally inside the same transaction that writes `learning_progress`,
/// so a class-subject summary is one indexed lookup instead of a scan over every
/// participant's every activity. It is derived data — rebuildable from
/// `learning_progress` and never a source of truth.
model ClassSubjectProgressAggregate {
  id                          String    @id @default(uuid()) @db.Uuid
  classSubjectId              String    @map("class_subject_id") @db.Uuid
  enrollmentId                String    @map("enrollment_id") @db.Uuid
  totalActivities             Int       @default(0) @map("total_activities")
  completedActivities         Int       @default(0) @map("completed_activities")
  requiredActivities          Int       @default(0) @map("required_activities")
  completedRequiredActivities Int       @default(0) @map("completed_required_activities")
  progressPercent             Int       @default(0) @map("progress_percent")
  lastActivityAt              DateTime? @map("last_activity_at")
  recalculatedAt              DateTime  @default(now()) @map("recalculated_at")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  @@unique([classSubjectId, enrollmentId])
  @@index([classSubjectId, progressPercent])
  @@index([enrollmentId])
  @@map("class_subject_progress_aggregates")
}

/// An assignment is coursework attached to a learning activity. `activityId` is
/// mandatory because an assignment only exists inside the learning flow; the
/// optional `assessmentId` lets the same work also feed the assessment domain
/// without duplicating the activity.
///
/// `dueAt` is nullable so an educator can publish the work before committing to
/// a deadline, but the service treats the stored value as the single authority —
/// the client never decides whether a submission is late.
model Assignment {
  id              String                    @id @default(uuid()) @db.Uuid
  activityId      String                    @map("activity_id") @db.Uuid
  activity        LearningActivity          @relation(fields: [activityId], references: [id], onDelete: Restrict)
  assessmentId    String?                   @map("assessment_id") @db.Uuid
  assessment      Assessment?               @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  title           String
  instructions    String?
  dueAt           DateTime?                 @map("due_at")
  maxScore        Int                       @default(100) @map("max_score")
  attemptsAllowed Int                       @default(1) @map("attempts_allowed")
  status          AssignmentLifecycleStatus @default(DRAFT)
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  submissions AssignmentSubmission[]

  @@unique([activityId])
  @@index([activityId])
  @@index([assessmentId])
  @@index([status])
  @@index([dueAt])
  @@map("assignments")
}

enum AssignmentLifecycleStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

/// One attempt by one participant.
///
/// `attemptNo` is unique per assignment and enrollment, and rows are never
/// overwritten: a resubmission appends the next attempt so the history of what
/// was handed in and when stays reconstructible, and an educator can still see
/// an earlier attempt after a later one was graded.
model AssignmentSubmission {
  id           String                     @id @default(uuid()) @db.Uuid
  assignmentId String                     @map("assignment_id") @db.Uuid
  assignment   Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  enrollmentId String                     @map("enrollment_id") @db.Uuid
  enrollment   Enrollment                 @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  attemptNo    Int                        @map("attempt_no")
  submittedAt  DateTime?                  @map("submitted_at")
  textAnswer   String?                    @map("text_answer")
  isLate       Boolean                    @default(false) @map("is_late")
  status       AssignmentSubmissionStatus @default(DRAFT)
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")

  files AssignmentSubmissionFile[]
  grade AssignmentGrade?

  @@unique([assignmentId, enrollmentId, attemptNo])
  @@index([assignmentId])
  @@index([enrollmentId])
  @@index([status])
  @@map("assignment_submissions")
}

enum AssignmentSubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
}

/// Join between a submission and a stored file.
///
/// The binary itself lives in object storage and is addressed through
/// `stored_files` (TASK-022); this table only records which already-uploaded,
/// already-confirmed file belongs to which submission attempt.
model AssignmentSubmissionFile {
  id           String               @id @default(uuid()) @db.Uuid
  submissionId String               @map("submission_id") @db.Uuid
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  storedFileId String               @map("stored_file_id") @db.Uuid
  storedFile   StoredFile           @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  label        String?
  createdAt    DateTime             @default(now()) @map("created_at")

  @@unique([submissionId, storedFileId])
  @@index([submissionId])
  @@index([storedFileId])
  @@map("assignment_submission_files")
}

/// One grade per submission, enforced by the unique key on `submissionId`.
///
/// Grading is keyed to the attempt, not to the assignment: a re-grade replaces
/// this row for its own attempt and never touches a previous attempt's score.
model AssignmentGrade {
  id             String               @id @default(uuid()) @db.Uuid
  submissionId   String               @unique @map("submission_id") @db.Uuid
  submission     AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  score          Decimal              @db.Decimal(7, 2)
  graderPersonId String               @map("grader_person_id") @db.Uuid
  graderPerson   Person               @relation(fields: [graderPersonId], references: [id], onDelete: Restrict)
  feedback       String?
  gradedAt       DateTime             @map("graded_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([graderPersonId])
  @@index([gradedAt])
  @@map("assignment_grades")
}

enum LearningMeetingStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  ARCHIVED
}

/// Activity types are data-driven so a new pedagogical form (discussion,
/// upload, reading, practice) is a row, not a schema change or a code branch.
/// `requiresContent` carries the publish rule per type: a reading activity
/// cannot be published without material, while a discussion activity may.
model LearningActivityType {
  id              String       @id @default(uuid()) @db.Uuid
  code            String       @unique
  name            String
  description     String?
  requiresContent Boolean      @default(true) @map("requires_content")
  status          MasterStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  activities LearningActivity[]

  @@index([status])
  @@map("learning_activity_types")
}

/// An activity is one actionable item inside a meeting. `sequence` is the order
/// the student walks through and is unique per meeting, so ordering is stable
/// and addressable rather than implied by dates.
model LearningActivity {
  id             String                 @id @default(uuid()) @db.Uuid
  meetingId      String                 @map("meeting_id") @db.Uuid
  meeting        LearningMeeting        @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  activityTypeId String                 @map("activity_type_id") @db.Uuid
  activityType   LearningActivityType   @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)
  sequence       Int
  title          String
  instructions   String?
  required       Boolean                @default(false)
  availableFrom  DateTime?              @map("available_from")
  availableUntil DateTime?              @map("available_until")
  status         LearningActivityStatus @default(DRAFT)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  contents LearningContent[]

  progress   LearningProgress[]
  assignment Assignment?

  @@unique([meetingId, sequence])
  @@index([meetingId])
  @@index([activityTypeId])
  @@index([status])
  @@map("learning_activities")
}

enum LearningActivityStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Content is metadata ONLY. Binaries live in object storage (MinIO/S3) and are
/// addressed by `objectKey`; no byte array is ever stored in PostgreSQL.
///
/// Versions of the same material share a `versionGroupId`, and `version` is
/// unique inside that group. Superseding published material appends a new row
/// and marks the previous published row SUPERSEDED, so what a student was shown
/// stays reconstructible instead of being overwritten.
model LearningContent {
  id             String                @id @default(uuid()) @db.Uuid
  activityId     String                @map("activity_id") @db.Uuid
  activity       LearningActivity      @relation(fields: [activityId], references: [id], onDelete: Restrict)
  versionGroupId String                @map("version_group_id") @db.Uuid
  contentType    LearningContentType   @map("content_type")
  title          String
  objectKey      String?               @map("object_key")
  externalUrl    String?               @map("external_url")
  mimeType       String?               @map("mime_type")
  sizeBytes      Int?                  @map("size_bytes")
  version        Int                   @default(1)
  status         LearningContentStatus @default(DRAFT)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@unique([versionGroupId, version])
  @@index([activityId])
  @@index([versionGroupId])
  @@index([status])
  @@map("learning_contents")
}

enum LearningContentType {
  FILE
  LINK
}

enum LearningContentStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

model EducationBatch {
  id                 String               @id @default(uuid()) @db.Uuid
  educationProgramId String               @map("education_program_id") @db.Uuid
  educationProgram   EducationProgram     @relation(fields: [educationProgramId], references: [id], onDelete: Restrict)
  curriculumId       String               @map("curriculum_id") @db.Uuid
  curriculum         Curriculum           @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  code               String
  name               String
  startDate          DateTime             @map("start_date") @db.Date
  endDate            DateTime             @map("end_date") @db.Date
  status             EducationBatchStatus @default(ACTIVE)
  capacity           Int?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  classes            AcademicClass[]
  enrollments        Enrollment[]
  graduationRules    GraduationRule[]

  @@unique([educationProgramId, code])
  @@index([educationProgramId])
  @@index([curriculumId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("education_batches")
}

model AcademicClass {
  id               String                 @id @default(uuid()) @db.Uuid
  educationBatchId String                 @map("education_batch_id") @db.Uuid
  educationBatch   EducationBatch         @relation(fields: [educationBatchId], references: [id], onDelete: Restrict)
  code             String
  name             String
  capacity         Int?
  status           AcademicClassStatus    @default(ACTIVE)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  classSubjects    ClassSubject[]
  enrollments      Enrollment[]
  staffAssignments ClassStaffAssignment[]

  @@unique([educationBatchId, code])
  @@index([educationBatchId])
  @@index([status])
  @@map("academic_classes")
}

enum AcademicClassStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

enum UserAccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Person {
  id                  String                 @id @default(uuid()) @db.Uuid
  personnelNumber     String                 @unique @map("personnel_number")
  fullName            String                 @map("full_name")
  rank                String?
  title               String?
  email               String?
  phone               String?
  status              PersonStatus           @default(ACTIVE)
  metadata            Json?
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  userAccount         UserAccount?
  placements          PersonOrganization[]
  enrollments         Enrollment[]
  educatorAssignments EducatorAssignment[]
  staffAssignments    ClassStaffAssignment[]
  assignmentGrades    AssignmentGrade[]
  answerGrades        AnswerGrade[]

  @@index([status])
  @@index([fullName])
  @@map("persons")
}

model UserAccount {
  id                             String                  @id @default(uuid()) @db.Uuid
  personId                       String                  @unique @map("person_id") @db.Uuid
  person                         Person                  @relation(fields: [personId], references: [id], onDelete: Restrict)
  externalAuthId                 String?                 @unique @map("external_auth_id")
  username                       String?
  email                          String?
  status                         UserAccountStatus       @default(ACTIVE)
  lastLoginAt                    DateTime?               @map("last_login_at")
  createdAt                      DateTime                @default(now()) @map("created_at")
  updatedAt                      DateTime                @updatedAt @map("updated_at")
  roleAssignments                UserRoleAssignment[]
  storedFiles                    StoredFile[]
  recordedAttendanceRecords      AttendanceRecord[]
  requestedAttendanceCorrections AttendanceCorrection[]  @relation("AttendanceCorrectionRequester")
  approvedAttendanceCorrections  AttendanceCorrection[]  @relation("AttendanceCorrectionApprover")
  approvedFinalGrades            FinalGrade[]            @relation("FinalGradeApprover")
  publishedGraduationRules       GraduationRule[]        @relation("GraduationRulePublisher")
  graduationEvaluations          GraduationEvaluation[]  @relation("GraduationEvaluator")
  graduationDecisionsMade        GraduationDecision[]    @relation("GraduationDecisionMaker")
  graduationDecisionsApproved    GraduationDecision[]    @relation("GraduationDecisionApprover")
  graduationDecisionsRevoked     GraduationDecision[]    @relation("GraduationDecisionRevoker")
  issuedCertificates             Certificate[]           @relation("CertificateIssuer")
  certificateRevocations         CertificateRevocation[] @relation("CertificateRevoker")

  @@index([status])
  @@map("user_accounts")
}

/// Metadata for a binary stored in object storage (TASK-022).
///
/// There is deliberately no `data`/`bytes` column: binaries never enter
/// PostgreSQL, and `objectKey` is the only pointer. The key is generated by the
/// server from the namespace, owner, date and a generated id — a client filename
/// is kept only as sanitized display metadata in `originalName`, never as a path
/// segment.
///
/// The lifecycle is: PENDING (upload initiated, nothing confirmed yet) ->
/// UPLOADED (completion confirmed against storage) -> ACTIVE (available for use)
/// or ARCHIVED (retired logically, bytes retained for retention policy).
model StoredFile {
  id           String           @id @default(uuid()) @db.Uuid
  objectKey    String           @unique @map("object_key")
  namespace    String
  originalName String           @map("original_name")
  mimeType     String           @map("mime_type")
  sizeBytes    Int              @map("size_bytes")
  checksum     String?
  ownerUserId  String?          @map("owner_user_id") @db.Uuid
  owner        UserAccount?     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  status       StoredFileStatus @default(PENDING)
  uploadedAt   DateTime?        @map("uploaded_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  submissionFiles AssignmentSubmissionFile[]
  certificates    Certificate[]

  @@index([namespace])
  @@index([ownerUserId])
  @@index([status])
  @@map("stored_files")
}

enum StoredFileStatus {
  PENDING
  UPLOADED
  ACTIVE
  ARCHIVED
}

model PersonOrganization {
  id             String       @id @default(uuid()) @db.Uuid
  personId       String       @map("person_id") @db.Uuid
  person         Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  positionName   String?      @map("position_name")
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime?    @map("end_date") @db.Date
  isPrimary      Boolean      @default(false) @map("is_primary")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([personId])
  @@index([organizationId])
  @@index([startDate])
  @@index([personId, isPrimary])
  @@map("person_organizations")
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

/// Roles are data. Authorization is always evaluated against permissions and
/// scopes, never against a role code string in business logic.
model Role {
  id              String               @id @default(uuid()) @db.Uuid
  code            String               @unique
  name            String
  description     String?
  isSystem        Boolean              @default(false) @map("is_system")
  status          RoleStatus           @default(ACTIVE)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  permissions     RolePermission[]
  roleAssignments UserRoleAssignment[]

  @@index([status])
  @@index([isSystem])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

/// Idempotent role-permission link: the composite primary key makes granting
/// the same permission twice a no-op instead of a duplicate row.
model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum UserRoleAssignmentStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum ScopeType {
  ORGANIZATION
  PROGRAM
  BATCH
  CLASS
  CLASS_SUBJECT
}

model UserRoleAssignment {
  id            String                   @id @default(uuid()) @db.Uuid
  userAccountId String                   @map("user_account_id") @db.Uuid
  userAccount   UserAccount              @relation(fields: [userAccountId], references: [id], onDelete: Restrict)
  roleId        String                   @map("role_id") @db.Uuid
  role          Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  validFrom     DateTime                 @default(now()) @map("valid_from")
  validUntil    DateTime?                @map("valid_until")
  status        UserRoleAssignmentStatus @default(ACTIVE)
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  scopes        RoleAssignmentScope[]

  @@index([userAccountId])
  @@index([roleId])
  @@index([status])
  @@index([validFrom, validUntil])
  @@map("user_role_assignments")
}

model RoleAssignmentScope {
  id           String             @id @default(uuid()) @db.Uuid
  assignmentId String             @map("assignment_id") @db.Uuid
  assignment   UserRoleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  scopeType    ScopeType          @map("scope_type")
  scopeId      String             @map("scope_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at")

  @@unique([assignmentId, scopeType, scopeId])
  @@index([assignmentId])
  @@index([scopeType, scopeId])
  @@map("role_assignment_scopes")
}

/// Immutable audit trail for sensitive mutations (TASK-006).
///
/// Append-only by design: rows are written once and never updated or deleted,
/// which the repository enforces by exposing no update/delete operation and the
/// migration enforces with a database trigger.
///
/// `actorUserAccountId` and `organizationId` are intentionally plain UUID
/// columns without a foreign key. Audit history must outlive the records it
/// describes, and a cascading or nullifying constraint would rewrite history the
/// first time an actor or organization is removed. They are documented as
/// historical identifiers rather than live references.
///
/// `before`/`after` are mapped onto `before_state`/`after_state` columns. The
/// API-facing field names stay spec-exact, while the physical column names are
/// self-documenting and avoid quoting the `BEFORE` trigger keyword when the
/// append-only guard in the migration references them.
model AuditLog {
  id                 String   @id @default(uuid()) @db.Uuid
  actorUserAccountId String?  @map("actor_user_account_id") @db.Uuid
  action             String
  resourceType       String   @map("resource_type")
  resourceId         String?  @map("resource_id")
  organizationId     String?  @map("organization_id") @db.Uuid
  before             Json?    @map("before_state") @db.JsonB
  after              Json?    @map("after_state") @db.JsonB
  metadata           Json?    @db.JsonB
  ipAddress          String?  @map("ip_address")
  userAgent          String?  @map("user_agent")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([actorUserAccountId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Attendance session for a class subject, optionally tied to a specific learning meeting.
model AttendanceSession {
  id             String                  @id @default(uuid()) @db.Uuid
  classSubjectId String                  @map("class_subject_id") @db.Uuid
  classSubject   ClassSubject            @relation(fields: [classSubjectId], references: [id], onDelete: Restrict)
  meetingId      String?                 @map("meeting_id") @db.Uuid
  meeting        LearningMeeting?        @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  title          String?
  startAt        DateTime                @map("start_at")
  endAt          DateTime                @map("end_at")
  method         AttendanceMethod        @default(MANUAL)
  status         AttendanceSessionStatus @default(OPEN)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  records AttendanceRecord[]

  @@index([classSubjectId])
  @@index([meetingId])
  @@index([status])
  @@index([startAt, endAt])
  @@map("attendance_sessions")
}

enum AttendanceMethod {
  MANUAL
  QR_CODE
  ONLINE
  INTEGRATION
}

enum AttendanceSessionStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

/// Record of attendance for one participant in one session.
///
/// `status` here is the CURRENT value only. Every change after the initial
/// recording goes through `AttendanceCorrection`, which keeps the previous
/// status, the reason and who approved it — so "who changed this, when, and why"
/// stays reconstructible instead of being overwritten.
model AttendanceRecord {
  id               String            @id @default(uuid()) @db.Uuid
  sessionId        String            @map("session_id") @db.Uuid
  session          AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  enrollmentId     String            @map("enrollment_id") @db.Uuid
  enrollment       Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  status           AttendanceStatus  @default(ABSENT)
  checkInAt        DateTime?         @map("check_in_at")
  note             String?
  recordedByUserId String?           @map("recorded_by_user_id") @db.Uuid
  recordedByUser   UserAccount?      @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  corrections AttendanceCorrection[]

  @@unique([sessionId, enrollmentId])
  @@index([sessionId])
  @@index([enrollmentId])
  @@index([status])
  @@map("attendance_records")
}

enum AttendanceStatus {
  PRESENT
  LATE
  EXCUSED
  SICK
  ABSENT
}

/// Append-only correction history for an attendance record.
///
/// A correction is never deleted and never edited: the previous value, the new
/// value, the mandatory reason and the requester/approver are written once, and
/// the record's `status` is updated in the same transaction. Keeping history in
/// its own table (rather than a `previousStatus` column on the record) means the
/// full chain of corrections survives, and the audit trail can point at one
/// immutable row per correction.
model AttendanceCorrection {
  id                 String                     @id @default(uuid()) @db.Uuid
  attendanceRecordId String                     @map("attendance_record_id") @db.Uuid
  attendanceRecord   AttendanceRecord           @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  previousStatus     AttendanceStatus           @map("previous_status")
  newStatus          AttendanceStatus           @map("new_status")
  reason             String
  requestedByUserId  String?                    @map("requested_by_user_id") @db.Uuid
  requestedByUser    UserAccount?               @relation("AttendanceCorrectionRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedByUserId   String?                    @map("approved_by_user_id") @db.Uuid
  approvedByUser     UserAccount?               @relation("AttendanceCorrectionApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  approvedAt         DateTime?                  @map("approved_at")
  status             AttendanceCorrectionStatus @default(APPLIED)
  createdAt          DateTime                   @default(now()) @map("created_at")

  @@index([attendanceRecordId, createdAt])
  @@index([requestedByUserId])
  @@index([approvedByUserId])
  @@index([status])
  @@map("attendance_corrections")
}

/// Corrections are applied immediately in this task's minimal workflow, but the
/// status is modelled explicitly so a future four-eyes approval flow can add
/// PENDING/REJECTED without changing the history table.
enum AttendanceCorrectionStatus {
  PENDING
  APPLIED
  REJECTED
}

enum AttendanceSummaryScopeType {
  ENROLLMENT
  ENROLLMENT_SUBJECT
  CLASS_SUBJECT
  CLASS
  BATCH
  PROGRAM
}

/// Pre-aggregated attendance summary reporting table (TASK-033).
///
/// Stores precalculated attendance counts and percentages per scope
/// (enrollment, class subject, class, batch, program) to provide fast O(1) reads
/// for reporting and executive overview without performing full raw scans over
/// attendance records.
model AttendanceSummary {
  id                   String                     @id @default(uuid()) @db.Uuid
  scopeType            AttendanceSummaryScopeType @map("scope_type")
  scopeId              String                     @map("scope_id") @db.Uuid
  enrollmentId         String?                    @map("enrollment_id") @db.Uuid
  classSubjectId       String?                    @map("class_subject_id") @db.Uuid
  academicClassId      String?                    @map("academic_class_id") @db.Uuid
  educationBatchId     String?                    @map("education_batch_id") @db.Uuid
  academicProgramId    String?                    @map("academic_program_id") @db.Uuid
  participants         Int                        @default(0)
  totalSessions        Int                        @default(0) @map("total_sessions")
  presentCount         Int                        @default(0) @map("present_count")
  lateCount            Int                        @default(0) @map("late_count")
  excusedCount         Int                        @default(0) @map("excused_count")
  sickCount            Int                        @default(0) @map("sick_count")
  absentCount          Int                        @default(0) @map("absent_count")
  attendancePercentage Float                      @default(0) @map("attendance_percentage")
  recalculatedAt       DateTime                   @default(now()) @map("recalculated_at")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  @@unique([scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@index([enrollmentId])
  @@index([classSubjectId])
  @@index([academicClassId])
  @@index([educationBatchId])
  @@index([academicProgramId])
  @@map("attendance_summaries")
}

/// Assessment method catalogue (TASK-040).
///
/// Types are data-driven rows, not an enum in code: QUIZ, EXAM, ASSIGNMENT,
/// PRACTICAL, OBSERVATION and COMPETENCY are seeded rows, and an institution
/// can add its own method without a schema change or a code branch. Reusing
/// `MasterStatus` keeps the retire-a-value semantics identical to the other
/// controlled vocabularies (`educator_types`, `learning_activity_types`).
model AssessmentType {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  description String?
  status      MasterStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  assessments Assessment[]

  @@index([status])
  @@map("assessment_types")
}

/// Umbrella assessment record (TASK-040).
///
/// An assessment is a graded activity attached to one class subject. It is
/// deliberately method-agnostic: the `assessmentType` row decides whether the
/// assessment is a quiz, a practical or a competency check, so later tasks
/// (question bank, exam, grading) can hang off the same umbrella instead of
/// each inventing its own container.
///
/// `maxScore` is the denominator and is required. `weight` is nullable and
/// only meaningful once a grading scheme (TASK-050) aggregates several
/// assessments into a final score; a NULL weight means "not yet weighted"
/// rather than zero.
///
/// Rows are never deleted destructively once PUBLISHED: the lifecycle moves
/// through CLOSED/ARCHIVED so anything already shown to participants stays
/// reconstructible.
model Assessment {
  id               String           @id @default(uuid()) @db.Uuid
  classSubjectId   String           @map("class_subject_id") @db.Uuid
  classSubject     ClassSubject     @relation(fields: [classSubjectId], references: [id], onDelete: Restrict)
  assessmentTypeId String           @map("assessment_type_id") @db.Uuid
  assessmentType   AssessmentType   @relation(fields: [assessmentTypeId], references: [id], onDelete: Restrict)
  title            String
  description      String?
  maxScore         Decimal          @map("max_score") @db.Decimal(7, 2)
  weight           Decimal?         @db.Decimal(5, 2)
  availableFrom    DateTime?        @map("available_from")
  availableUntil   DateTime?        @map("available_until")
  status           AssessmentStatus @default(DRAFT)
  metadata         Json?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  assignments              Assignment[]
  gradingComponents        GradingComponent[]
  exam                     Exam?
  graduationRuleComponents GraduationRuleComponent[]

  @@index([classSubjectId])
  @@index([assessmentTypeId])
  @@index([status])
  @@index([availableFrom])
  @@map("assessments")
}

enum GradingSchemeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model GradingScheme {
  id             String              @id @default(uuid()) @db.Uuid
  classSubjectId String              @map("class_subject_id") @db.Uuid
  classSubject   ClassSubject        @relation(fields: [classSubjectId], references: [id], onDelete: Restrict)
  name           String
  status         GradingSchemeStatus @default(DRAFT)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  components  GradingComponent[]
  finalGrades FinalGrade[]

  @@index([classSubjectId])
  @@index([status])
  @@map("grading_schemes")
}

model GradingComponent {
  id           String        @id @default(uuid()) @db.Uuid
  schemeId     String        @map("scheme_id") @db.Uuid
  scheme       GradingScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  assessmentId String        @map("assessment_id") @db.Uuid
  assessment   Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  name         String
  weight       Decimal       @db.Decimal(5, 2)
  required     Boolean       @default(false)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([schemeId, assessmentId])
  @@index([schemeId])
  @@index([assessmentId])
  @@map("grading_components")
}

enum FinalGradeStatus {
  CALCULATED
  APPROVED
  REOPENED
}

model FinalGrade {
  id               String           @id @default(uuid()) @db.Uuid
  enrollmentId     String           @map("enrollment_id") @db.Uuid
  enrollment       Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  classSubjectId   String           @map("class_subject_id") @db.Uuid
  classSubject     ClassSubject     @relation(fields: [classSubjectId], references: [id], onDelete: Restrict)
  gradingSchemeId  String           @map("grading_scheme_id") @db.Uuid
  gradingScheme    GradingScheme    @relation(fields: [gradingSchemeId], references: [id], onDelete: Restrict)
  numericScore     Decimal          @map("numeric_score") @db.Decimal(5, 2)
  gradeCode        String?          @map("grade_code")
  status           FinalGradeStatus @default(CALCULATED)
  calculatedAt     DateTime         @default(now()) @map("calculated_at")
  approvedByUserId String?          @map("approved_by_user_id") @db.Uuid
  approvedByUser   UserAccount?     @relation("FinalGradeApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  approvedAt       DateTime?        @map("approved_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@unique([enrollmentId, classSubjectId])
  @@index([enrollmentId])
  @@index([classSubjectId])
  @@index([status])
  @@index([approvedByUserId])
  @@map("final_grades")
}

/// Graduation rule (TASK-052).
///
/// A rule is the *configurable, versioned* statement of what a participant must
/// satisfy to graduate from a batch: attendance percentage, a minimum weighted
/// final score, required subjects, and a final exam. It is scoped to a batch and
/// carries a `version`, and components are immutable once the rule is published.
///
/// Publisering freezes the rule so an evaluation can point at an exact rule
/// version and remain reproducible forever: a later threshold edit creates a new
/// version instead of silently rewriting what an earlier evaluation meant
/// (`docs/03-data-architecture.md` — history stays reconstructible).
model GraduationRule {
  id                String                    @id @default(uuid()) @db.Uuid
  educationBatchId  String                    @map("education_batch_id") @db.Uuid
  educationBatch    EducationBatch            @relation(fields: [educationBatchId], references: [id], onDelete: Restrict)
  code              String
  name              String
  description       String?
  version           Int                       @default(1)
  status            GraduationRuleStatus      @default(DRAFT)
  publishedAt       DateTime?                 @map("published_at")
  publishedByUserId String?                   @map("published_by_user_id") @db.Uuid
  publishedByUser   UserAccount?              @relation("GraduationRulePublisher", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  components        GraduationRuleComponent[]
  evaluations       GraduationEvaluation[]
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  @@unique([educationBatchId, code, version])
  @@index([educationBatchId])
  @@index([status])
  @@map("graduation_rules")
}

enum GraduationRuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// One requirement inside a graduation rule.
///
/// Components are data-driven rows rather than an enum so the rule set can grow
/// without a schema change. `componentType` selects the evaluator; the present
/// threshold columns depend on that type:
/// - `ATTENDANCE_PERCENTAGE` uses `thresholdValue`.
/// - `FINAL_SCORE` uses `thresholdValue`.
/// - `REQUIRED_SUBJECT` uses `subjectId` (and optionally `thresholdValue`).
/// - `FINAL_EXAM` uses `assessmentId` (and optionally `thresholdValue`).
model GraduationRuleComponent {
  id               String                  @id @default(uuid()) @db.Uuid
  graduationRuleId String                  @map("graduation_rule_id") @db.Uuid
  graduationRule   GraduationRule          @relation(fields: [graduationRuleId], references: [id], onDelete: Cascade)
  componentType    GraduationComponentType @map("component_type")
  label            String
  thresholdValue   Decimal?                @map("threshold_value") @db.Decimal(5, 2)
  subjectId        String?                 @map("subject_id") @db.Uuid
  subject          Subject?                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  assessmentId     String?                 @map("assessment_id") @db.Uuid
  assessment       Assessment?             @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  required         Boolean                 @default(true)
  sortOrder        Int                     @default(0) @map("sort_order")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@unique([graduationRuleId, componentType, label])
  @@index([graduationRuleId])
  @@index([subjectId])
  @@index([assessmentId])
  @@map("graduation_rule_components")
}

enum GraduationComponentType {
  ATTENDANCE_PERCENTAGE
  FINAL_SCORE
  REQUIRED_SUBJECT
  FINAL_EXAM
}

/// Evaluation of one participant against one published rule.
///
/// This is deliberately *not* the graduation decision (that is TASK-053): an
/// evaluation records what the rule system observed about a participant at a
/// point in time. Keeping them separate means a formal decision can be
/// reconsidered, corrected, or revoked without destroying the evidence it was
/// based on.
///
/// `snapshot` carries the exact inputs and thresholds used, so the outcome can be
/// recomputed and audited even after later data changes. An evaluation that has
/// been superseded is replaced, never silently overwritten: re-running creates a
/// new row and marks the previous one `SUPERSEDED`.
model GraduationEvaluation {
  id                String                       @id @default(uuid()) @db.Uuid
  enrollmentId      String                       @map("enrollment_id") @db.Uuid
  enrollment        Enrollment                   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  graduationRuleId  String                       @map("graduation_rule_id") @db.Uuid
  graduationRule    GraduationRule               @relation(fields: [graduationRuleId], references: [id], onDelete: Restrict)
  outcome           GraduationEvaluationOutcome  @default(PENDING)
  evaluatedAt       DateTime                     @default(now()) @map("evaluated_at")
  evaluatedByUserId String?                      @map("evaluated_by_user_id") @db.Uuid
  evaluatedByUser   UserAccount?                 @relation("GraduationEvaluator", fields: [evaluatedByUserId], references: [id], onDelete: Restrict)
  snapshot          Json
  details           GraduationEvaluationDetail[]
  decision          GraduationDecision?
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")

  @@index([enrollmentId])
  @@index([graduationRuleId])
  @@index([outcome])
  @@map("graduation_evaluations")
}

enum GraduationEvaluationOutcome {
  PENDING
  ELIGIBLE
  NOT_ELIGIBLE
  SUPERSEDED
}

/// The formal graduation decision (TASK-053).
///
/// This is deliberately a separate table from `GraduationEvaluation`: an
/// evaluation is evidence produced by the rule engine, while a decision is a
/// human act with an author, a date, and a reason. Keeping them apart is what
/// lets a decision be corrected or revoked without destroying the evidence it
/// rested on.
///
/// `graduationEvaluationId` is unique: one evaluation carries at most one
/// decision row. A correction does not add a second row for the same
/// evaluation — it moves the existing row forward in its lifecycle
/// (`status`), and the audit trail (TASK-006) records every move. That is why
/// there is no `supersedesDecisionId` here: superseding already happens one
/// level up, where a re-evaluation supersedes its predecessor evaluation.
///
/// The record is never deleted, so "who decided, when, and why" stays
/// answerable after a revocation.
model GraduationDecision {
  id                     String                    @id @default(uuid()) @db.Uuid
  graduationEvaluationId String                    @unique @map("graduation_evaluation_id") @db.Uuid
  graduationEvaluation   GraduationEvaluation      @relation(fields: [graduationEvaluationId], references: [id], onDelete: Restrict)
  decision               GraduationDecisionOutcome
  status                 GraduationDecisionStatus  @default(DRAFT)
  decidedByUserId        String?                   @map("decided_by_user_id") @db.Uuid
  decidedByUser          UserAccount?              @relation("GraduationDecisionMaker", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  decidedAt              DateTime?                 @map("decided_at")
  approvedByUserId       String?                   @map("approved_by_user_id") @db.Uuid
  approvedByUser         UserAccount?              @relation("GraduationDecisionApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  approvedAt             DateTime?                 @map("approved_at")
  revokedByUserId        String?                   @map("revoked_by_user_id") @db.Uuid
  revokedByUser          UserAccount?              @relation("GraduationDecisionRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  revokedAt              DateTime?                 @map("revoked_at")
  revokedReason          String?                   @map("revoked_reason")
  note                   String?
  certificate            Certificate?
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  @@index([status])
  @@index([decision])
  @@index([decidedByUserId])
  @@index([approvedByUserId])
  @@map("graduation_decisions")
}

/// The verdict a decision records.
///
/// `PASS` and `FAIL` are terminal verdicts. `REMEDIAL` is the institution's
/// "not yet — do remedial work and be reconsidered" verdict; it exists so that
/// a learner who misses a requirement by a small margin is not recorded as a
/// permanent failure. `WITHDRAWN` covers formal withdrawal from the programme.
enum GraduationDecisionOutcome {
  PASS
  FAIL
  REMEDIAL
  WITHDRAWN
}

/// Lifecycle of a decision row.
///
/// `DRAFT` is recorded but not yet in force; `APPROVED` is the in-force state
/// and is what downstream features (certificates, TASK-054) consume; `REVOKED`
/// is terminal — the row stays readable because an institution must be able to
/// prove a decision was once made and later withdrawn.
///
/// There is no DELETE anywhere in this lifecycle: revocation is a status, not
/// an erasure.
enum GraduationDecisionStatus {
  DRAFT
  APPROVED
  REVOKED
}

/// A reusable certificate design (TASK-054).
///
/// Templates are versioned on `(code, version)` rather than edited in place, so
/// a certificate issued last year can still name the exact template version it
/// was printed from. Editing an in-use template would silently rewrite history:
/// the same certificate number would appear to have been issued under a design
/// that did not exist at the time.
///
/// The design itself lives in object storage (`templateObjectKey`, TASK-022);
/// only a pointer and non-binary presentation `config` are kept here, because
/// uploaded binaries must never be stored in PostgreSQL.
model CertificateTemplate {
  id                String                    @id @default(uuid()) @db.Uuid
  code              String
  name              String
  description       String?
  version           Int                       @default(1)
  status            CertificateTemplateStatus @default(DRAFT)
  templateObjectKey String?                   @map("template_object_key")
  config            Json?
  certificates      Certificate[]
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  @@unique([code, version])
  @@index([status])
  @@map("certificate_templates")
}

enum CertificateTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// An issued certificate (TASK-054).
///
/// The certificate is derived from an *approved* graduation decision, and
/// `decisionId` is unique: one decision yields at most one certificate. That is
/// what makes "only an eligible PASS decision can be certified" a structural
/// property rather than a rule someone has to remember — the decision is the
/// only thing a certificate can point at, and the service refuses any decision
/// that is not `APPROVED` with outcome `PASS`.
///
/// Two independent random values are stored:
/// - `certificateNumber` is the human-facing identifier printed on the document.
/// - `verificationCode` is the secret-ish lookup key used by the public
///   verification endpoint. It is generated with a CSPRNG so it cannot be
///   guessed by enumerating plausible numbers.
///
/// `fileId` points at the rendered PDF in object storage (TASK-022) and is
/// nullable: a certificate can be recorded before its document is rendered.
/// The binary never lives in PostgreSQL.
///
/// The row is never deleted. Revocation (TASK-055) moves `status`, so the
/// institution can still prove a certificate was once issued and later
/// withdrawn.
model Certificate {
  id                String                 @id @default(uuid()) @db.Uuid
  decisionId        String                 @unique @map("decision_id") @db.Uuid
  decision          GraduationDecision     @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  templateId        String                 @map("template_id") @db.Uuid
  template          CertificateTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  certificateNumber String                 @unique @map("certificate_number")
  verificationCode  String                 @unique @map("verification_code")
  status            CertificateStatus      @default(ISSUED)
  issuedAt          DateTime               @map("issued_at")
  issuedByUserId    String?                @map("issued_by_user_id") @db.Uuid
  issuedByUser      UserAccount?           @relation("CertificateIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  fileId            String?                @map("file_id") @db.Uuid
  file              StoredFile?            @relation(fields: [fileId], references: [id], onDelete: Restrict)
  revocation        CertificateRevocation?
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@index([templateId])
  @@index([status])
  @@index([issuedAt])
  @@index([issuedByUserId])
  @@map("certificates")
}

/// Revocation evidence for a certificate (TASK-055).
///
/// This is a separate table rather than extra columns on `certificates` for the
/// same reason TASK-053 keeps decisions apart from evaluations: the certificate
/// records what was issued, while this table records who withdrew it, when, and
/// why. Keeping the reason in its own row means the act of revoking survives
/// independently of how the certificate is read.
///
/// `certificateId` is unique: a certificate is revoked at most once. Re-revoking
/// is refused rather than appended, so there is one authoritative reason instead
/// of a history that has to be interpreted. Revocation is a withdrawal, not a
/// deletion — the `Certificate` row and its number remain, which is what lets an
/// institution still prove that a document was once legitimately issued.
///
/// There is no `delete` and no `update`: like the audit trail (TASK-006), the
/// evidence is only meaningful while it is immutable.
model CertificateRevocation {
  id              String       @id @default(uuid()) @db.Uuid
  certificateId   String       @unique @map("certificate_id") @db.Uuid
  certificate     Certificate  @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  reason          String
  revokedByUserId String?      @map("revoked_by_user_id") @db.Uuid
  revokedByUser   UserAccount? @relation("CertificateRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  revokedAt       DateTime     @default(now()) @map("revoked_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([revokedByUserId])
  @@index([revokedAt])
  @@map("certificate_revocations")
}

/// Certificate lifecycle.
///
/// `REVOKED` is declared here rather than added later because revocation is a
/// state of a certificate, not a separate kind of record. TASK-055 supplies the
/// `certificate_revocations` evidence table and the workflow that moves the
/// status; the vocabulary itself belongs with the model.
///
enum CertificateStatus {
  ISSUED
  REVOKED
}

/// One component result inside an evaluation snapshot.
///
/// The row is the evidence: it stores the observed value alongside the threshold
/// that applied, so "why was this participant not eligible" is answerable from
/// the evaluation alone, without re-querying live data that may since have
/// changed.
model GraduationEvaluationDetail {
  id                     String                  @id @default(uuid()) @db.Uuid
  graduationEvaluationId String                  @map("graduation_evaluation_id") @db.Uuid
  graduationEvaluation   GraduationEvaluation    @relation(fields: [graduationEvaluationId], references: [id], onDelete: Cascade)
  componentType          GraduationComponentType @map("component_type")
  label                  String
  observedValue          Decimal?                @map("observed_value") @db.Decimal(8, 2)
  thresholdValue         Decimal?                @map("threshold_value") @db.Decimal(5, 2)
  passed                 Boolean
  note                   String?
  createdAt              DateTime                @default(now()) @map("created_at")

  @@index([graduationEvaluationId])
  @@map("graduation_evaluation_details")
}

/// Pre-aggregated reporting metrics per scope (TASK-060).
///
/// This is the reporting boundary's read model. Reporting questions — "how many
/// participants, how much progress, what attendance, what score" — would
/// otherwise be answered by scanning `enrollments`, `class_subject_progress_aggregates`,
/// `attendance_summaries` and `final_grades` and joining them on every request.
/// Those tables keep growing, while an executive screen is opened far more often
/// than the underlying data changes, so the cost of computing on read is paid
/// repeatedly for the same answer.
///
/// One row per `(scopeType, scopeId)`. The parent id columns are denormalized so
/// a drill-down can select a whole subtree — "every class in this batch" — with
/// one indexed predicate instead of a recursive join through the hierarchy.
///
/// Two rules keep this honest:
///
/// - **The transactional tables remain the source of truth.** Every column here
///   is derived and is recomputed from source in `refresh`; nothing in this table
///   is ever written by a domain mutation directly, and the row can always be
///   discarded and rebuilt.
/// - **A refresh is idempotent.** `refresh` recomputes the metrics from source
///   and upserts on `(scopeType, scopeId)`, so running it twice yields the same
///   row rather than doubling a count. That is what makes it safe to call on a
///   schedule, after a backfill, or by hand after an incident.
///
/// `scopeType` is the reporting vocabulary (`docs/03-data-architecture.md`),
/// deliberately its own enum rather than a reuse of `ScopeType`: the
/// authorization scopes and the reporting scopes are different sets that happen
/// to overlap, and coupling them would make an authorization vocabulary change
/// silently reshape stored reports.
model ReportingMetric {
  id                 String             @id @default(uuid()) @db.Uuid
  scopeType          ReportingScopeType
  scopeId            String             @map("scope_id") @db.Uuid
  scopeName          String?            @map("scope_name")
  organizationId     String?            @map("organization_id") @db.Uuid
  educationProgramId String?            @map("education_program_id") @db.Uuid
  educationBatchId   String?            @map("education_batch_id") @db.Uuid
  academicClassId    String?            @map("academic_class_id") @db.Uuid
  classSubjectId     String?            @map("class_subject_id") @db.Uuid

  participants           Int   @default(0)
  activeParticipants     Int   @default(0) @map("active_participants")
  averageProgressPercent Float @default(0) @map("average_progress_percent")
  attendancePercentage   Float @default(0) @map("attendance_percentage")
  totalSessions          Int   @default(0) @map("total_sessions")
  averageFinalScore      Float @default(0) @map("average_final_score")
  gradedCount            Int   @default(0) @map("graded_count")
  unapprovedGradeCount   Int   @default(0) @map("unapproved_grade_count")

  /// Denominators and totals kept alongside the averages (TASK-061).
  ///
  /// An executive roll-up has to combine child scopes into a parent figure, and
  /// averages cannot be averaged: a class of 10 and a class of 200 would carry
  /// equal weight. Storing the totals and the counts they were divided by makes
  /// the parent figure exactly reconstructible as `sum(total) / sum(count)`
  /// instead of approximately re-derived from rounded means.
  attendedCount        Int   @default(0) @map("attended_count")
  progressPercentTotal Float @default(0) @map("progress_percent_total")
  progressSampleCount  Int   @default(0) @map("progress_sample_count")
  finalScoreTotal      Float @default(0) @map("final_score_total")

  /// Graduation counters (TASK-061).
  ///
  /// Counted during refresh so the executive overview stays a read of this table.
  /// The three are deliberately distinct: an evaluation is evidence the rule
  /// engine produced, an approval is a human act in force, and a certificate is a
  /// document issued. Reporting one number for "graduated" would hide which of
  /// those three a reader is actually looking at.
  graduationEvaluationCount Int @default(0) @map("graduation_evaluation_count")
  graduationEligibleCount   Int @default(0) @map("graduation_eligible_count")
  graduationApprovedCount   Int @default(0) @map("graduation_approved_count")
  graduatedCount            Int @default(0) @map("graduated_count")

  /// Batch period this scope belongs to (TASK-061).
  ///
  /// Denormalized from the batch so a period filter is an indexed predicate on
  /// the read model. Joining back to `education_batches` at request time would
  /// put a transactional table on the read path that this table exists to keep
  /// clear.
  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date

  recalculatedAt DateTime @default(now()) @map("recalculated_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@index([organizationId])
  @@index([educationProgramId])
  @@index([educationBatchId])
  @@index([academicClassId])
  @@index([classSubjectId])
  @@index([recalculatedAt])
  @@index([periodStart, periodEnd])
  @@map("reporting_metrics")
}

/// Reporting scope vocabulary (TASK-060).
///
/// Hierarchical, in drill-down order: Organization → Program → Batch → Class →
/// ClassSubject, with Enrollment for a single participant.
enum ReportingScopeType {
  ORGANIZATION
  PROGRAM
  BATCH
  CLASS
  CLASS_SUBJECT
  ENROLLMENT
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

/// A question bank is the reusable, class-independent pool of questions from
/// which exams draw. It is scoped to a curriculum subject (TASK-011) rather
/// than to a class subject: a bank outlives the classes that use it, and the
/// same bank feeds every batch that later teaches the subject.
///
/// A bank is only ever retired by flipping `status` to INACTIVE; it is never
/// deleted, because an attempt may still reference a version of a question
/// underneath it. Authorship is not duplicated here — the audit trail (TASK-006)
/// already records who changed what.
model QuestionBank {
  id                  String            @id @default(uuid()) @db.Uuid
  curriculumSubjectId String            @map("curriculum_subject_id") @db.Uuid
  curriculumSubject   CurriculumSubject @relation(fields: [curriculumSubjectId], references: [id], onDelete: Restrict)
  code                String
  name                String
  description         String?
  status              MasterStatus      @default(ACTIVE)
  metadata            Json?
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  questions Question[]

  blueprintRules ExamBlueprintRule[]

  @@unique([curriculumSubjectId, code])
  @@index([curriculumSubjectId])
  @@index([status])
  @@map("question_banks")
}

/// Question types are a controlled vocabulary, exactly like `assessment_types`:
/// the baseline rows are seeded by migration and an institution can add its own
/// (essay, short answer, matching, ...) without a schema or code change.
///
/// `hasOptions` and `multiSelect` make option validation DATA-DRIVEN: the
/// service reads the flags off the selected type instead of branching on a code,
/// so a new option-based type behaves correctly the moment it is inserted.
/// Nothing here ever reaches a student-facing payload.
model QuestionType {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  description String?
  hasOptions  Boolean      @default(false) @map("has_options")
  multiSelect Boolean      @default(false) @map("multi_select")
  status      MasterStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  questions      Question[]
  blueprintRules ExamBlueprintRule[]

  @@index([status])
  @@map("question_types")
}

/// A question is a stable identity. Its editable content does NOT live here —
/// it lives in append-only `QuestionVersion` snapshots. `code` is an optional
/// human reference unique within its bank.
model Question {
  id             String       @id @default(uuid()) @db.Uuid
  questionBankId String       @map("question_bank_id") @db.Uuid
  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Restrict)
  questionTypeId String       @map("question_type_id") @db.Uuid
  questionType   QuestionType @relation(fields: [questionTypeId], references: [id], onDelete: Restrict)
  code           String?
  /// `MasterStatus` mirrors the vocabulary tables: an INACTIVE question is
  /// retired from new exam blueprints while its versions stay readable for
  /// historical attempts.
  status         MasterStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  versions QuestionVersion[]

  @@unique([questionBankId, code])
  @@index([questionBankId])
  @@index([questionTypeId])
  @@index([status])
  @@map("questions")
}

/// An immutable snapshot of a question at a point in time.
///
/// Rows are append-only. `(questionId, version)` is unique, and the service
/// refuses to mutate a row once it leaves DRAFT, so an attempt recorded against
/// version 3 keeps rendering the exact stem and options that were shown — even
/// after the author rewrites the question into version 4.
///
/// `stem` is the question text; `scoringRule` holds the machine-readable answer
/// key (e.g. the correct option keys and the points awarded) so scoring never
/// has to infer the answer. `explanation` is the post-grading rationale;
/// `difficulty` and `topic` are the classification metadata an exam blueprint
/// filters on (TASK-042). The correct answer lives BOTH in `scoringRule` and on
/// the options, and neither is ever serialized into a student-facing DTO.
model QuestionVersion {
  id          String                @id @default(uuid()) @db.Uuid
  questionId  String                @map("question_id") @db.Uuid
  question    Question              @relation(fields: [questionId], references: [id], onDelete: Restrict)
  version     Int
  stem        String
  scoringRule Json?                 @map("scoring_rule")
  explanation String?
  difficulty  String?
  topic       String?
  maxScore    Decimal               @default(1) @map("max_score") @db.Decimal(7, 2)
  status      QuestionVersionStatus @default(DRAFT)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  options          QuestionOption[]
  attemptQuestions AttemptQuestion[]

  @@unique([questionId, version])
  @@index([questionId])
  @@index([status])
  @@map("question_versions")
}

enum QuestionVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

/// An answer choice belonging to one immutable version.
///
/// `isCorrect` and `value` are SERVER-ONLY: they exist to score an attempt and
/// are stripped by the student-safe projection before a question ever reaches a
/// participant. `versionId` (not `questionId`) is the owner precisely so a
/// historical attempt resolves the option set that existed at the time.
model QuestionOption {
  id        String          @id @default(uuid()) @db.Uuid
  versionId String          @map("version_id") @db.Uuid
  version   QuestionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  /// Stable within a version; a scoring rule refers to this, not to the row id.
  key       String
  label     String
  isCorrect Boolean         @default(false) @map("is_correct")
  value     Decimal?        @db.Decimal(7, 2)
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")

  @@unique([versionId, key])
  @@index([versionId])
  @@map("question_options")
}

/// Exam definition (TASK-042).
///
/// An exam is the DELIVERY configuration of exactly one assessment: how long a
/// participant gets, how many attempts they may take, and how the question set
/// is drawn. It occupies its own table rather than adding columns to
/// `Assessment` because an assessment is the graded umbrella — a quiz, a
/// practical or an essay — while only some of those are delivered as an online
/// timed exam. Keeping them apart lets TASK-050 grade a practical that has no
/// exam row at all, and lets an exam's randomization policy change without
/// touching the record participants were measured against.
///
/// `assessmentId` is unique: one assessment has at most one delivery
/// configuration, so "which exam grades this assessment" never has two answers.
///
/// `durationMinutes` is the base clock. It is deliberately NOT the authoritative
/// deadline — TASK-044 computes `expiresAt` on the server from the actual start
/// instant, bounded by the session window (TASK-043). `timeZone` exists only so
/// a printed schedule renders in institutional local time; it never shifts the
/// stored instants, which are UTC.
///
/// Randomization is split into three independent switches because they solve
/// different problems: shuffling questions defeats copy-from-neighbour,
/// shuffling options defeats "the answer is B", and drawing from a declared pool
/// is what lets two participants in the same session sit different papers while
/// still being measured against the same blueprint.
model Exam {
  id                    String     @id @default(uuid()) @db.Uuid
  /// Unique: one assessment has at most one exam delivery configuration.
  assessmentId          String     @unique @map("assessment_id") @db.Uuid
  assessment            Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  title                 String
  instructions          String?
  durationMinutes       Int        @map("duration_minutes")
  /// NULL means unlimited attempts. Bounded by the session window in TASK-043.
  attemptsAllowed       Int?       @map("attempts_allowed")
  shuffleQuestions      Boolean    @default(true) @map("shuffle_questions")
  shuffleOptions        Boolean    @default(true) @map("shuffle_options")
  /// Whether the participant sees their score immediately after submitting.
  /// Defaults to false so a shared cohort result cannot leak between sessions.
  showResultImmediately Boolean    @default(false) @map("show_result_immediately")
  /// IANA time-zone name used for display only. Instants stay UTC.
  timeZone              String?    @map("time_zone")
  status                ExamStatus @default(DRAFT)
  /// Blueprint version this configuration reflects; started attempts pin it.
  configVersion         Int        @default(1) @map("config_version")
  metadata              Json?
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  blueprint ExamBlueprint?
  rules     ExamBlueprintRule[]
  sessions  ExamSession[]

  @@index([status])
  @@index([assessmentId])
  @@map("exams")
}

/// Lifecycle of an exam definition.
///
/// `DRAFT -> VALIDATED` records that the blueprint was checked against the live
/// question pool and passed. `VALIDATED -> SCHEDULED` is the point of no return:
/// from there the configuration is frozen because sessions and attempts may
/// depend on it, and a correction is a new configuration version, not an edit.
/// `ARCHIVED` is terminal so historical attempts stay reconstructible.
enum ExamStatus {
  DRAFT
  VALIDATED
  SCHEDULED
  CLOSED
  ARCHIVED
}

/// The declared shape of an exam paper.
///
/// The blueprint answers "how many questions do we ask, how many points is the
/// paper worth, and how is that composed". It is stored per exam (one-to-one)
/// because it is edited together with the exam and never reused across exams —
/// a reusable blueprint would be a separate concept with its own identity.
///
/// `totalQuestions` and `totalPoints` are denormalized from the rules so the
/// expensive part of validation — "is the pool deep enough" — can be answered
/// without re-aggregating rules, and so a discrepancy between the declared total
/// and the sum of the rules is detectable rather than silently averaged away.
/// The service recomputes them from the rules on every write; they are never
/// accepted from the client.
model ExamBlueprint {
  id             String            @id @default(uuid()) @db.Uuid
  examId         String            @unique @map("exam_id") @db.Uuid
  exam           Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  title          String?
  description    String?
  totalQuestions Int               @map("total_questions")
  totalPoints    Decimal           @map("total_points") @db.Decimal(9, 2)
  /// How the draw behaves when a rule's bank holds MORE qualifying questions
  /// than the rule asks for. Static configurations pick a fixed subset per
  /// participant set; `POOL` means each attempt draws its own subset.
  selectionMode  ExamSelectionMode @default(FIXED) @map("selection_mode")
  metadata       Json?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  rules ExamBlueprintRule[]

  @@index([examId])
  @@map("exam_blueprints")
}

enum ExamSelectionMode {
  /// Every attempt for this exam draws the same subset from each rule's pool.
  FIXED
  /// Each attempt draws its own subset from each rule's pool.
  POOL
}

enum ExamSessionStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  CANCELLED
}

enum ExamParticipantStatus {
  INVITED
  ELIGIBLE
  DISQUALIFIED
  COMPLETED
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  CANCELLED
}

model ExamAttempt {
  id            String            @id @default(uuid()) @db.Uuid
  participantId String            @map("participant_id") @db.Uuid
  participant   ExamParticipant   @relation(fields: [participantId], references: [id], onDelete: Restrict)
  attemptNo     Int               @map("attempt_no")
  startedAt     DateTime          @map("started_at")
  expiresAt     DateTime          @map("expires_at")
  submittedAt   DateTime?         @map("submitted_at")
  status        ExamAttemptStatus @default(IN_PROGRESS)
  score         Decimal?          @db.Decimal(9, 2)
  questions     AttemptQuestion[]
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@unique([participantId, attemptNo])
  @@index([participantId, status])
  @@index([expiresAt, status])
  @@map("exam_attempts")
}

model AttemptQuestion {
  id                String          @id @default(uuid()) @db.Uuid
  attemptId         String          @map("attempt_id") @db.Uuid
  attempt           ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionVersionId String          @map("question_version_id") @db.Uuid
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  sequence          Int
  points            Decimal         @db.Decimal(7, 2)
  optionOrder       Json?           @map("option_order")
  answer            AttemptAnswer?

  @@unique([attemptId, sequence])
  @@unique([attemptId, questionVersionId])
  @@index([questionVersionId])
  @@map("attempt_questions")
}

model AttemptAnswer {
  id                String          @id @default(uuid()) @db.Uuid
  attemptQuestionId String          @unique @map("attempt_question_id") @db.Uuid
  attemptQuestion   AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)
  grade             AnswerGrade?
  answerPayload     Json            @map("answer_payload")
  revision          Int             @default(1)
  savedAt           DateTime        @default(now()) @map("saved_at")

  @@index([savedAt])
  @@map("attempt_answers")
}

model AnswerGrade {
  id              String        @id @default(uuid()) @db.Uuid
  attemptAnswerId String        @unique @map("attempt_answer_id") @db.Uuid
  attemptAnswer   AttemptAnswer @relation(fields: [attemptAnswerId], references: [id], onDelete: Cascade)
  autoScore       Decimal?      @map("auto_score") @db.Decimal(9, 2)
  manualScore     Decimal?      @map("manual_score") @db.Decimal(9, 2)
  finalScore      Decimal       @map("final_score") @db.Decimal(9, 2)
  graderPersonId  String?       @map("grader_person_id") @db.Uuid
  grader          Person?       @relation(fields: [graderPersonId], references: [id], onDelete: Restrict)
  feedback        String?
  gradedAt        DateTime      @default(now()) @map("graded_at")

  @@index([graderPersonId, gradedAt])
  @@index([gradedAt])
  @@map("answer_grades")
}

model ExamSession {
  id           String            @id @default(uuid()) @db.Uuid
  examId       String            @map("exam_id") @db.Uuid
  exam         Exam              @relation(fields: [examId], references: [id], onDelete: Restrict)
  startAt      DateTime          @map("start_at")
  endAt        DateTime          @map("end_at")
  status       ExamSessionStatus @default(DRAFT)
  settings     Json?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  participants ExamParticipant[]

  @@index([examId])
  @@index([status, startAt, endAt])
  @@map("exam_sessions")
}

model ExamParticipant {
  id             String                @id @default(uuid()) @db.Uuid
  sessionId      String                @map("session_id") @db.Uuid
  session        ExamSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId   String                @map("enrollment_id") @db.Uuid
  enrollment     Enrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  status         ExamParticipantStatus @default(INVITED)
  accommodations Json?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  attempts       ExamAttempt[]

  @@unique([sessionId, enrollmentId])
  @@index([enrollmentId])
  @@index([sessionId, status])
  @@map("exam_participants")
}

/// One line of the blueprint: "draw N questions from bank X, filtered by topic
/// and difficulty, worth P points each".
///
/// Every filter except `count` and `pointsPerQuestion` is nullable, and a NULL
/// filter means "do not constrain on this axis" rather than "match NULL". This
/// is what makes a blueprint composable: a rule can pin a bank and a topic while
/// leaving difficulty open, or pin difficulty while drawing from any bank in the
/// curriculum subject.
///
/// `questionBankId` is nullable because a rule may legitimately draw from every
/// bank in the exam's curriculum subject. `questionTypeId` is also nullable so a
/// rule can mix types; option-based-count validation is therefore applied to the
/// bank+type pairs actually present in the pool rather than to the rule.
///
/// `pointsPerQuestion` is the per-question value. The paper's score is the sum of
/// `count * pointsPerQuestion` over all rules, which the service checks against
/// the assessment's `maxScore` — a mismatch would silently rescale every grade.
model ExamBlueprintRule {
  id                String        @id @default(uuid()) @db.Uuid
  examId            String        @map("exam_id") @db.Uuid
  exam              Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  blueprintId       String        @map("blueprint_id") @db.Uuid
  blueprint         ExamBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  /// Stable within a blueprint; audit entries and validation messages refer to
  /// this instead of to the row id, which changes when rules are reordered.
  code              String
  label             String?
  sortOrder         Int           @default(0) @map("sort_order")
  questionBankId    String?       @map("question_bank_id") @db.Uuid
  questionBank      QuestionBank? @relation(fields: [questionBankId], references: [id], onDelete: Restrict)
  questionTypeId    String?       @map("question_type_id") @db.Uuid
  questionType      QuestionType? @relation(fields: [questionTypeId], references: [id], onDelete: Restrict)
  /// Matches `QuestionVersion.topic` exactly; NULL means any topic.
  topic             String?
  /// Matches `QuestionVersion.difficulty` exactly; NULL means any difficulty.
  difficulty        String?
  count             Int
  pointsPerQuestion Decimal       @map("points_per_question") @db.Decimal(7, 2)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@unique([blueprintId, code])
  @@index([blueprintId])
  @@index([examId])
  @@index([questionBankId])
  @@index([questionTypeId])
  @@map("exam_blueprint_rules")
}
