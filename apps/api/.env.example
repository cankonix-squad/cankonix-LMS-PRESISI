NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://lemdiklat:change-me@localhost:5432/lemdiklat?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lemdiklat-lms
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me
KEYCLOAK_ISSUER=http://localhost:8080/realms/lemdiklat
KEYCLOAK_AUDIENCE=lemdiklat-api
# Optional: derived from KEYCLOAK_ISSUER when omitted.
# KEYCLOAK_JWKS_URI=http://localhost:8080/realms/lemdiklat/protocol/openid-connect/certs
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_JWKS_CACHE_SECONDS=300
AUTH_JWKS_TIMEOUT_MS=5000
AUTH_LAST_LOGIN_THROTTLE_SECONDS=300

# --- Keycloak Admin API (user provisioning) ---------------------------------
# Optional. When any of these are set, the API can create/link Keycloak users
# from the Admin UI. When omitted, provisioning endpoints fail closed with 503
# and every other feature keeps working. Secrets here are NEVER stored in the
# LMS database and are never sent to a frontend.
#
# Keycloak base URL + realm (both derived from KEYCLOAK_ISSUER when omitted):
# KEYCLOAK_ADMIN_BASE_URL=http://localhost:8080
# KEYCLOAK_ADMIN_REALM=lemdiklat
#
# Preferred: a confidential client with a service account holding the realm
# roles `manage-users` and `view-users` (see src/keycloak-provisioning/README.md).
# KEYCLOAK_ADMIN_CLIENT_ID=lms-admin-api
# KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
#
# Alternative (dev only): an administrator username/password using the
# `password` grant. Prefer the service account so no human credential lives in
# the API environment.
# KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD=change-me
#
# Set to `false` to make a new password permanent instead of a one-time credential.
KEYCLOAK_ADMIN_RESET_PASSWORD_TEMPORARY=true
KEYCLOAK_ADMIN_TIMEOUT_MS=8000

# OpenAPI documentation is enabled outside production unless set explicitly.
# DOCS_ENABLED=false
