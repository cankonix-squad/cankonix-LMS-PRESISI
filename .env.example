COMPOSE_PROJECT_NAME=lemdiklat-lms

POSTGRES_DB=lemdiklat
POSTGRES_USER=lemdiklat
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8080

# Keycloak Admin API used by the LMS API to provision users (optional).
# Create a confidential client with a service account holding the realm roles
# `manage-users` and `view-users`, then set the two values below. Leave empty to
# disable provisioning (the endpoints fail closed with 503).
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
